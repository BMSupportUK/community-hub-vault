# Copy to .env.test and fill in real values. .env.test is gitignored.

# Where the test runs. Defaults to local dev server on :8080.
# To target a deployed env, set e.g. https://project--<id>.lovable.app
E2E_BASE_URL=http://localhost:8080

# Test accounts — must already exist in the backend.
# Buyer: any approved (non-staff) user who has access to the order below.
E2E_BUYER_EMAIL=buyer@example.com
E2E_BUYER_PASSWORD=changeme

# Staff: a user with admin / management / staff / moderator role.
E2E_STAFF_EMAIL=staff@example.com
E2E_STAFF_PASSWORD=changeme

# An existing order id the buyer owns. Both sessions open this order's chat.
E2E_ORDER_ID=00000000-0000-0000-0000-000000000000